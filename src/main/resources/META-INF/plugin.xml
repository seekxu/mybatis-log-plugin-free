<idea-plugin>
	<id>com.starxg.mybatis-log-plugin-free</id>
	<name>MyBatis Log Free</name>

	<vendor email="591269@gmail.com" url="http://github.com/starxg">starxg</vendor>

	<description><![CDATA[
	Restore mybatis sql log to original whole executable sql.
	<br/>
	<img width="350" height="210" src="https://blog.starxg.com/img/2021/10/1-2-2.png"  alt=""/>
	<br/>
	<b>usage:</>
	<ol>
		<li>Click the MyBatis Log icon in the bottom tool window</li>
		<li>Or click Tools -> MyBatis Log Plugin</li>
	</ol>
    <a href="https://github.com/starxg/mybatis-log-plugin-free">github</a> | <a href="https://github.com/starxg/mybatis-log-plugin-free/issues">issues</a> | <a href="https://ko-fi.com/huangxingguang">donate</a>
    ]]></description>

	<depends>com.intellij.modules.platform</depends>

	<extensions defaultExtensionNs="com.intellij">
		<!-- Extension: filter for console output -->
		<consoleFilterProvider implementation="com.starxg.mybatislog.MyBatisLogConsoleFilterProvider"/>

		<!-- ToolWindow: fixed at bottom, click icon to open -->
		<toolWindow id="MyBatis Log Plugin Free"
					anchor="bottom"
					icon="/icons/ibatis.svg"
					factoryClass="com.starxg.mybatislog.gui.MyBatisLogToolWindowFactory"/>
	</extensions>

	<actions>
		<action id="com.starxg.mybatislog.action.MyBatisLogAction" class="com.starxg.mybatislog.action.MyBatisLogAction"
				text="MyBatis Log Plugin" description="MyBatis log plugin free" icon="/icons/ibatis.svg">
			<add-to-group group-id="ToolsMenu" anchor="last"/>
			<add-to-group group-id="ConsoleEditorPopupMenu" anchor="before" relative-to-action="ConsoleView.ClearAll"/>
		</action>
	</actions>
</idea-plugin>