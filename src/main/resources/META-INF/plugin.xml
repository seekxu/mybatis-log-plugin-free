<idea-plugin>
	<id>com.seekxu.mybatis-log-restorer</id>
	<name>MyBatis Log Restorer</name>

	<vendor email="contact@seekxu.com" url="http://github.com/seekxu">seekxu</vendor>

	<description><![CDATA[
	Restore MyBatis SQL logs to original executable SQL.
	<br/>
	Forked from starxg/mybatis-log-plugin-free - refactored to independent ToolWindow architecture.
	<br/>
	<b>usage:</b>
	<ol>
		<li>Click the MyBatis Log Restorer icon in the bottom tool window</li>
	</ol>
    <a href="https://github.com/seekxu/mybatis-log-restorer">github</a> | <a href="https://github.com/seekxu/mybatis-log-restorer/issues">issues</a> | <a href="https://ko-fi.com/seekxu">donate</a>
    ]]></description>

	<depends>com.intellij.modules.platform</depends>

	<extensions defaultExtensionNs="com.intellij">
		<!-- Extension: filter for console output -->
		<consoleFilterProvider implementation="com.starxg.mybatislog.MyBatisLogConsoleFilterProvider"/>

		<!-- ToolWindow: fixed at bottom, click icon to open -->
		<toolWindow id="MyBatis Log Restorer"
					anchor="bottom"
					icon="/icons/ibatis.svg"
					factoryClass="com.starxg.mybatislog.gui.MyBatisLogToolWindowFactory"/>
	</extensions>

	<actions>
		<action id="com.seekxu.mybatislog.action.MyBatisLogAction" class="com.starxg.mybatislog.action.MyBatisLogAction"
				text="MyBatis Log Restorer" description="MyBatis Log Restorer - Restore SQL logs" icon="/icons/ibatis.svg">
			<add-to-group group-id="ToolsMenu" anchor="last"/>
			<add-to-group group-id="ConsoleEditorPopupMenu" anchor="before" relative-to-action="ConsoleView.ClearAll"/>
		</action>
	</actions>
</idea-plugin>